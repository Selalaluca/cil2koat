<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- F#はファイルの並び順がコンパイル順=依存関係の順になる点がC#と違う -->
    <Compile Include="Cfg.fs" />
    <Compile Include="Expressions.fs" />
    <Compile Include="CilTypes.fs" />
    <Compile Include="AbstractValues.fs" />
    <Compile Include="StackSim.fs" />
    <Compile Include="GuardNormalization.fs" />
    <Compile Include="Analysis.fs" />
    <Compile Include="TransitionSyntax.fs" />
    <Compile Include="TransitionValidation.fs" />
    <Compile Include="TransitionIr.fs" />
    <Compile Include="Koat.fs" />
    <Compile Include="MethodSelection.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
  </ItemGroup>

</Project>
